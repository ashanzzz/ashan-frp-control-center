{
  "name": "ashan-frp-control-center",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "tsc -p src/web/tsconfig.json",
    "build": "npm run build:web",
    "start": "node --experimental-strip-types src/server/index.ts",
    "dev": "node --watch --experimental-strip-types src/server/index.ts",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
