<?xml version="1.0"?>
<Container version="2">
  <Name>Ashan-FRP-Control-Center</Name>
  <Repository>ghcr.io/ashanzzz/ashan-frp-control-center:latest</Repository>
  <Registry>https://github.com/ashanzzz/ashan-frp-control-center/pkgs/container/ashan-frp-control-center</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/ashanzzz/ashan-frp-control-center/issues</Support>
  <Project>https://github.com/ashanzzz/ashan-frp-control-center</Project>
  <Overview>Rust full-stack ChmlFrp global tunnel control center. All managed tunnels share one global active node; confirmed FRPC node faults trigger one global failover and Cloudflare A records are updated last.</Overview>
  <Category>Network:Other</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <TemplateURL/>
  <Icon></Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled>0</DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Requires>Place the ChmlFrp frpc Linux binary at /mnt/cache/appdata/ashan-frp-control-center/frpc/frpc and make it executable.</Requires>
  <Config Name="WebUI Port" Target="8080" Default="8080" Mode="tcp" Description="Control Center WebUI" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="App Data" Target="/data" Default="/mnt/cache/appdata/ashan-frp-control-center" Mode="rw" Description="SQLite, FRPC config/revisions and runtime data" Type="Path" Display="always" Required="true" Mask="false">/mnt/cache/appdata/ashan-frp-control-center</Config>
  <Config Name="ChmlFrp Token" Target="CHMLFRP_TOKEN" Default="" Mode="" Description="ChmlFrp API token" Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="Cloudflare API Token" Target="CLOUDFLARE_API_TOKEN" Default="" Mode="" Description="Cloudflare scoped DNS edit token" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Cloudflare Zone ID" Target="CLOUDFLARE_ZONE_ID" Default="" Mode="" Description="Managed Cloudflare Zone ID" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Active ChmlFrp Node" Target="ACTIVE_NODE" Default="" Mode="" Description="Initial global active node name" Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="Standby ChmlFrp Node" Target="STANDBY_NODE" Default="" Mode="" Description="Preferred global standby node name" Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="Quarantine Days" Target="QUARANTINE_DAYS" Default="30" Mode="" Description="Days a confirmed failed node is excluded from selection" Type="Variable" Display="always" Required="true" Mask="false">30</Config>
  <Config Name="Automatic Failover" Target="FAILOVER_ENABLED" Default="true" Mode="" Description="Enable FRPC log driven global failover" Type="Variable" Display="always" Required="true" Mask="false">true</Config>
</Container>
