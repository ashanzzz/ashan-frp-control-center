<?xml version="1.0"?>
<Container version="2">
  <Name>Ashan-FRP-Control-Center</Name>
  <Repository>ghcr.io/ashanzzz/ashan-frp-control-center:latest</Repository>
  <Registry>https://github.com/ashanzzz/ashan-frp/pkgs/container/ashan-frp-control-center</Registry>
  <Network>host</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/ashanzzz/ashan-frp/issues</Support>
  <Project>https://github.com/ashanzzz/ashan-frp</Project>
  <Overview>个人自托管的 ChmlFrp 高可用控制中心。镜像内置并守护官方 frpc，无需额外 frpc 容器；提供节点测速、隧道与 DNS 增量对账、OAuth、健康检查、自动故障切换和回滚。</Overview>
  <Category>Network:Other Productivity: Tools:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <Icon>https://raw.githubusercontent.com/ashanzzz/ashan-frp/main/docs/assets/icon.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled>0</DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Requires>推荐使用 Host 网络，使内置 frpc 能访问 Unraid 本机与局域网服务。无需 Docker Socket，也无需挂载其他 frpc 容器目录。</Requires>
  <Config Name="Application Data" Target="/data" Default="/mnt/user/appdata/ashan-frp-control" Mode="rw" Description="SQLite、主密钥、FRPC 配置、日志、任务、审计和备份" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/ashan-frp-control</Config>
  <Config Name="WebUI Port" Target="HTTP_PORT" Default="8080" Mode="" Description="Host 网络下控制中心监听端口" Type="Variable" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Cookie Secure" Target="COOKIE_SECURE" Default="false" Mode="" Description="通过 HTTPS 访问时改为 true" Type="Variable" Display="advanced" Required="false" Mask="false">false</Config>
</Container>
