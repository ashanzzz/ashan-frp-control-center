HTTP_ADDR=0.0.0.0:8080
DATA_DIR=/data
DATABASE_URL=sqlite:///data/control-center.db
WEB_DIR=/app/web
RUST_LOG=ashan_frp_server=info,info

# ChmlFrp v2
CHMLFRP_BASE_URL=https://cf-v2.uapis.cn
CHMLFRP_TOKEN=

# Cloudflare API Token auth
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ChmlFrp client binary + generated config destination
FRPC_BINARY=/data/frpc/frpc
FRPC_CONFIG=/data/frpc/frpc.ini
FRPC_LOG_TAIL=500

# Global routing defaults. Can be changed through the API/UI later.
ACTIVE_NODE=
STANDBY_NODE=
QUARANTINE_DAYS=30
FAILOVER_ENABLED=true
