HTTP_ADDR=0.0.0.0:8080
DATA_DIR=/data
DATABASE_URL=sqlite:///data/control-center.db
WEB_DIR=/app/web
RUST_LOG=ashan_frp_server=info

# Provider variables are optional first-start bootstrap seeds only.
# Preferred setup: start the container, then configure/test providers in WebUI -> Settings.
# Once a provider secret exists in SQLite under /data, restarts do not overwrite it from env.
CHMLFRP_BASE_URL=https://cf-v2.uapis.cn
CHMLFRP_TOKEN=

CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

FRPC_BINARY=/data/frpc/frpc
FRPC_CONFIG=/data/frpc/frpc.ini
FRPC_LOG_TAIL=500

# Optional first-start routing seeds. Later changes belong in the WebUI.
ACTIVE_NODE=
STANDBY_NODE=
QUARANTINE_DAYS=30
FAILOVER_ENABLED=true
