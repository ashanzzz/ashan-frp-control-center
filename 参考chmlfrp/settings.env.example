# 把本文件复制为 settings.env 后修改（与脚本放在同一目录）。

# 建议：把 chmlfrp.sh 与 new_fix_flow.sh 以及这些配置文件放进同一个目录
# （也就是你说的 chmlfrp 日志目录），这样 Unraid User Scripts 管理最省心。

# ===== 目录与文件 =====
# LOG_DIR 默认=脚本所在目录；一般不用改。
# LOG_DIR="/mnt/user/Hdd_Disk_Share/脚本日志/chmlfrp"

# userdata / 固定隧道 / 豁免文件（默认都在 LOG_DIR 下）
# 注意：userdata / fixed_tunnels 的扩展名用 .txt（方便 Unraid 编辑器打开），但内容仍是 JSON。
# USERDATA_FILE="$LOG_DIR/userdata.txt"
# FIXED_TUNNEL_FILE="$LOG_DIR/fixed_tunnels.txt"
# EXEMPT_NAMES_FILE="$LOG_DIR/exempt_names.txt"

# ===== frpc =====
FRPC_DOCKER_NAME="frpc"
FRPC_DOCKER_IMAGE="snowdreamtech/frpc"
FRPC_CONFIG_PATH="/mnt/user/appdata/frpc/frpc.toml"

# ===== Cloudflare 主域名（用于 DNS 组合） =====
PRIMARY_DOMAIN="example.com"

# ===== 节点筛选（可选） =====
# yes/no/all
FILTER_CHINA="all"
FILTER_TYPE="all"
FILTER_BUILD_SITE="all"
# notes 包含关键字（逗号分隔），空表示不筛选
FILTER_NOTES=""

# ===== 自动化策略 =====
NODE_REFRESH_SECONDS=3600
COOLDOWN_SECONDS=900
BAN_SECONDS=3600
NODE_UNUSABLE_BAN_SECONDS=2592000
NODE_PROXY_CONFLICT_THRESHOLD=3
POST_RESTART_SETTLE_SECONDS=8
POST_RESTART_LOG_TAIL=120
MAX_TRIES=3

# ===== 健康检查（可选端到端） =====
# HEALTHCHECK_URL="https://your.domain/health"
