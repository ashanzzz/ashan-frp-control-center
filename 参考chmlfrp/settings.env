# 自动化策略（按需改）
PRIMARY_DOMAIN="335356119.xyz"

# 节点筛选（all 最宽松；你也可以改成 yes/vip/带宽 等）
FILTER_CHINA="yes"
FILTER_TYPE="all"
FILTER_BUILD_SITE="yes"
FILTER_NOTES=""

# 刷新节点列表周期（秒）
NODE_REFRESH_SECONDS=3600

# fastest 模式切线冷却（秒）
COOLDOWN_SECONDS=900

# 切线失败的节点 ban 时长（秒）
BAN_SECONDS=3600

# 节点被判定为“服务端/节点侧不可用”后的长冷却（30天）
NODE_UNUSABLE_BAN_SECONDS=2592000

# frpc 成功登录后，如果连续出现这么多次代理冲突，则判定该节点不可用
NODE_PROXY_CONFLICT_THRESHOLD=3

# 重建 frpc 后，等待容器稳定并抓日志判定的参数
POST_RESTART_SETTLE_SECONDS=8
POST_RESTART_LOG_TAIL=120

# 回退尝试次数
MAX_TRIES=3
FRPC_CONFIG_PATH="/mnt/user/appdata/frpc/frpc.toml"
